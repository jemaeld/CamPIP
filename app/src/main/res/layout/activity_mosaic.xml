<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.tvcampip.MosaicLayout
        android:id="@+id/mosaic"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No hay cámaras visibles.\nPulsa ☰ (o la tecla Menú) y elige «Gestionar cámaras» para agregarlas o activar su casilla."
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Menú hamburguesa: se oculta solo tras unos segundos y reaparece al pulsar cualquier tecla. -->
    <Button
        android:id="@+id/topBar"
        android:layout_width="56dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:alpha="0.85"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="☰"
        android:textSize="22sp" />
</FrameLayout>
